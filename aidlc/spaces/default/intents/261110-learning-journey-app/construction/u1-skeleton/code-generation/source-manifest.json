{
  "stage": "code-generation",
  "unit": "u1-skeleton",
  "version": 1,
  "writes": [
    { "path": "infra/" },
    { "path": "backend/" },
    { "path": "frontend/src/" },
    { "path": "frontend/tests/" },
    { "path": "frontend/index.html" },
    { "path": "frontend/styles.css" },
    { "path": "frontend/build.mjs" },
